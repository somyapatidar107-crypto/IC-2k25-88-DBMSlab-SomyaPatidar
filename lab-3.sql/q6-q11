-- Q6. Programmers or Shipping Clerks whose salary
-- is not equal to 4500, 10000, or 15000.
SELECT last_name, job_id, salary
FROM employees
WHERE job_id IN ('IT_PROG', 'SH_CLERK')
AND salary NOT IN (4500, 10000, 15000);


-- Q7. Employees whose last name has exactly 6 characters.
SELECT last_name
FROM employees
WHERE CHAR_LENGTH(last_name) = 6;


-- Q8. Employees whose third character in last name is 'e'.
SELECT last_name
FROM employees
WHERE last_name LIKE '__e%';


-- Q9. Display available jobs/designations.
SELECT DISTINCT job_id
FROM employees;


-- Q10. Display names, salary and PF (15% of salary).
SELECT first_name, last_name, salary,
       salary * 0.15 AS PF
FROM employees;


-- Q11. Employees whose last name is BLAKE, SCOTT, KING or FORD.
SELECT *
FROM employees
WHERE UPPER(last_name) IN ('BLAKE', 'SCOTT', 'KING', 'FORD');