
-- Q6. Calculate total salaries payable to employees.
SELECT SUM(salary) AS total_salary
FROM employees;


-- Q7. Find maximum and minimum salary.
SELECT
    MAX(salary) AS maximum_salary,
    MIN(salary) AS minimum_salary
FROM employees;


-- Q8. Find average salary and number of employees.
SELECT
    AVG(salary) AS average_salary,
    COUNT(*) AS total_employees
FROM employees;


-- Q9. Count the total number of employees.
SELECT COUNT(*) AS employee_count
FROM employees;


-- Q10. Count the number of different jobs.
SELECT COUNT(DISTINCT job_id) AS total_jobs
FROM employees;
